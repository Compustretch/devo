+	if got, want := readFile(t, stdinPath), "SELECT 1;\nSELECT 2;\nSELECT 2;\n"; got != want {
+		t.Errorf("piped %q, want only 002 re-run (%q)", got, want)
+	}
+	wantState(t, map[string]string{"001_a.sql": "applied", "002_b.sql": "applied"})
