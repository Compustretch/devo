+}
+
+func dotenvNames(root, name string) (map[string]bool, error) {
+	names := map[string]bool{}
+	path, err := projectPath(root, name)
+	if err != nil {
+		return nil, err
+	}
+	b, err := os.ReadFile(path)
+	if os.IsNotExist(err) {
+		return names, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	for i, line := range strings.Split(string(b), "\n") {
+		line = strings.TrimSpace(strings.TrimSuffix(line, "\r"))
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		line = strings.TrimSpace(strings.TrimPrefix(line, "export "))
+		key, _, ok := strings.Cut(line, "=")
+		if !ok || !validDotenvName(strings.TrimSpace(key)) {
+			return nil, fmt.Errorf("%s:%d: expected a valid NAME=value assignment", name, i+1)
+		}
+		names[strings.TrimSpace(key)] = true
+	}
+	return names, nil
+}
+
+func validDotenvName(name string) bool {
+	if name == "" || !(name[0] == '_' || name[0] >= 'A' && name[0] <= 'Z' || name[0] >= 'a' && name[0] <= 'z') {
+		return false
+	}
+	for i := 1; i < len(name); i++ {
+		c := name[i]
+		if !(c == '_' || c >= 'A' && c <= 'Z' || c >= 'a' && c <= 'z' || c >= '0' && c <= '9') {
+			return false
+		}
+	}
+	return true
+}
