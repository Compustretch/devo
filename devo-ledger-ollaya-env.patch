+func validateEnvAuthNames(root string, env, auth map[string]string) error {
+	envNames, err := dotenvNames(root, envFile)
+	if err != nil {
+		return err
+	}
+	authNames, err := dotenvNames(root, authFile)
+	if err != nil {
+		return err
+	}
+	for key := range env {
+		if !validDotenvName(key) {
+			return fmt.Errorf("invalid environment variable name %q in .env", key)
+		}
+		envNames[key] = true
+	}
+	for key := range auth {
+		if !validDotenvName(key) {
+			return fmt.Errorf("invalid environment variable name %q in .auth", key)
+		}
+		authNames[key] = true
+	}
+	for key := range envNames {
+		if authNames[key] {
+			return fmt.Errorf("%s is defined in both .env and .auth; move it to exactly one file", key)
+		}
