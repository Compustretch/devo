+++ b/internal/cli/dotenv.go
@@ -0,0 +1,203 @@
+package cli
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+var dotenvNameRE = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)
+
+// readProjectDotenv reads Devo's endpoint and credential files without
+// evaluating them as shell code. A variable may live in .env or .auth, never
+// both. .auth is required to be owner-readable/writable only.
+func readProjectDotenv(root string) (map[string]string, error) {
+	values := make(map[string]string)
+	sources := make(map[string]string)
+	for _, name := range []string{".env", ".auth"} {
+		path := filepath.Join(root, name)
+		info, err := os.Lstat(path)
+		if os.IsNotExist(err) {
+			continue
+		}
+		if err != nil {
+			return nil, fmt.Errorf("inspect %s: %w", name, err)
+		}
+		if info.Mode()&os.ModeSymlink != 0 || !info.Mode().IsRegular() {
+			return nil, fmt.Errorf("%s must be a regular file, not a symlink or directory", name)
+		}
+		if name == ".auth" && info.Mode().Perm()&0o077 != 0 {
+			return nil, fmt.Errorf(".auth permissions are %04o; run `chmod 600 %s`", info.Mode().Perm(), path)
+		}
+
+		entries, err := parseDotenvFile(path)
+		if err != nil {
+			return nil, err
+		}
+		for key, value := range entries {
+			if previous, exists := sources[key]; exists {
+				return nil, fmt.Errorf("%s is defined in both %s and %s; move it to exactly one file", key, previous, name)
+			}
+			sources[key] = name
+			values[key] = value
+		}
+	}
+	return values, nil
+}
+
+func parseDotenvFile(path string) (map[string]string, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read %s: %w", filepath.Base(path), err)
+	}
+	values := make(map[string]string)
+	for i, raw := range strings.Split(string(data), "\n") {
+		line := strings.TrimSpace(strings.TrimSuffix(raw, "\r"))
+		if i == 0 {
+			line = strings.TrimPrefix(line, "\uFEFF")
+		}
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		line = strings.TrimSpace(strings.TrimPrefix(line, "export "))
+		key, rawValue, ok := strings.Cut(line, "=")
+		if !ok {
+			return nil, fmt.Errorf("%s:%d: expected NAME=value", filepath.Base(path), i+1)
+		}
+		key = strings.TrimSpace(key)
+		if !dotenvNameRE.MatchString(key) {
+			return nil, fmt.Errorf("%s:%d: invalid environment variable name", filepath.Base(path), i+1)
+		}
+		if _, exists := values[key]; exists {
+			return nil, fmt.Errorf("%s:%d: %s is defined more than once", filepath.Base(path), i+1, key)
+		}
+		value, err := parseDotenvValue(rawValue)
+		if err != nil {
+			return nil, fmt.Errorf("%s:%d: %w", filepath.Base(path), i+1, err)
+		}
+		values[key] = value
+	}
+	return values, nil
+}
+
+func parseDotenvValue(raw string) (string, error) {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return "", nil
+	}
+	if raw[0] == '\'' {
+		end := strings.IndexByte(raw[1:], '\'')
+		if end < 0 {
+			return "", fmt.Errorf("unterminated single-quoted value")
+		}
+		value := raw[1 : end+1]
+		if tail := strings.TrimSpace(raw[end+2:]); tail != "" && !strings.HasPrefix(tail, "#") {
+			return "", fmt.Errorf("unexpected text after quoted value")
+		}
+		return value, nil
+	}
+	if raw[0] == '"' {
+		var value strings.Builder
+		closed := false
+		for i := 1; i < len(raw); i++ {
+			c := raw[i]
+			if c == '"' {
+				if tail := strings.TrimSpace(raw[i+1:]); tail != "" && !strings.HasPrefix(tail, "#") {
+					return "", fmt.Errorf("unexpected text after quoted value")
+				}
+				closed = true
+				break
+			}
+			if c != '\\' {
+				value.WriteByte(c)
+				continue
+			}
+			if i+1 >= len(raw) {
+				return "", fmt.Errorf("unterminated escape in double-quoted value")
+			}
+			i++
+			switch raw[i] {
+			case 'n':
+				value.WriteByte('\n')
+			case 'r':
+				value.WriteByte('\r')
+			case 't':
+				value.WriteByte('\t')
+			case '\\', '"', '$', '`':
+				value.WriteByte(raw[i])
+			default:
+				value.WriteByte('\\')
+				value.WriteByte(raw[i])
+			}
+		}
+		if !closed {
+			return "", fmt.Errorf("unterminated double-quoted value")
+		}
+		return value.String(), nil
+	}
+
+	// In unquoted values, a hash starts a comment only when preceded by space.
+	for i := 0; i < len(raw); i++ {
+		if raw[i] == '#' && (i == 0 || raw[i-1] == ' ' || raw[i-1] == '\t') {
+			raw = raw[:i]
+			break
+		}
+	}
+	return strings.TrimSpace(raw), nil
+}
+
+// projectEnvironment gives the process environment precedence over project
+// files. The returned slice is deterministic and can be assigned to exec.Cmd.Env.
+func projectEnvironment(root string) ([]string, error) {
+	fromFiles, err := readProjectDotenv(root)
+	if err != nil {
+		return nil, err
+	}
+	values := make(map[string]string, len(os.Environ())+len(fromFiles))
+	for _, entry := range os.Environ() {
+		if key, value, ok := strings.Cut(entry, "="); ok {
+			values[key] = value
+		}
+	}
+	for key, value := range fromFiles {
+		if _, exists := values[key]; !exists {
+			values[key] = value
+		}
+	}
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	env := make([]string, 0, len(keys))
+	for _, key := range keys {
+		env = append(env, key+"="+values[key])
+	}
+	return env, nil
+}
+
+// composeEnvFileArgs makes Compose use both files for interpolation. Passing
+// them here does not inject every variable into every container; a service must
+// explicitly reference a variable in its Compose environment to receive it.
+func composeEnvFileArgs(root string) ([]string, error) {
+	if _, err := readProjectDotenv(root); err != nil {
+		return nil, err
+	}
+	abs, err := filepath.Abs(root)
+	if err != nil {
+		return nil, err
+	}
+	var args []string
+	for _, name := range []string{".env", ".auth"} {
+		path := filepath.Join(abs, name)
+		if _, err := os.Stat(path); err == nil {
+			args = append(args, "--env-file", path)
+		} else if !os.IsNotExist(err) {
+			return nil, fmt.Errorf("inspect %s: %w", name, err)
+		}
+	}
+	return args, nil
+}
